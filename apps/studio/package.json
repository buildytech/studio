{
  "name": "@buildy/studio",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run test:unit && bun run test:dom",
    "build:desktop": "vite build --mode desktop",
    "check:kit": "ui8kit check",
    "rules:check": "bun scripts/rules-check.ts",
    "rules:baseline": "bun scripts/rules-check.ts --write",
    "test:unit": "bun test src scripts --path-ignore-patterns='**/*.dom.test.tsx'",
    "test:dom": "bun test --preload ./test/dom-setup.ts --conditions browser dom.test",
    "test:coverage": "bun test src scripts --path-ignore-patterns='**/*.dom.test.tsx' --coverage --coverage-reporter=text --coverage-reporter=lcov"
  },
  "dependencies": {
    "@buildy/agent-contract": "workspace:*",
    "@buildy/studio-panel-contract": "workspace:*",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@solidjs/router": "^0.15.3",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "lucide": "^1.79.0",
    "marked": "^18.0.6",
    "mermaid": "^11.16.0",
    "solid-js": "^1.9.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "7",
    "@babel/preset-typescript": "7",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "latest",
    "@types/jsdom": "^28.0.3",
    "babel-preset-solid": "1.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.2",
    "ui8kit": "3.5.0",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^2.11.6"
  }
}
